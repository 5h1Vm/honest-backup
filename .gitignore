# =========================
# REPOSITORY Browser Profile
# =========================

# Every spelling: a browser profile holds live session cookies,
# and a renamed one (honestbackup-profile.old) slipped past a
# pattern that only matched the exact directory name.
honestbackup-profile*
honestbackup-profile.tar.gz
